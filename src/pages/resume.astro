---
import Layout from '../layouts/Layout.astro';
import cv from '../data/resume.json';
import { projects } from '../data/projects';
const home = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/`;
---
<Layout title="工程实践 · Yuming Chen" description={cv.summary}>
  <div class="resume-toolbar wrap"><a href={`${home}#work`}>← 返回工程足迹</a><a href={`${home}projects/`}>浏览项目</a><a class="text-link" href={`${home}blog/`}>阅读工程笔记 ↗</a></div>
  <div class="resume-document">
    <header class="resume-heading"><p class="eyebrow">ENGINEERING PRACTICE</p><h1>{cv.name}</h1><p class="resume-role">{cv.role}</p><div class="resume-contact"><span>{cv.location}</span><a href={`mailto:${cv.email}`}>{cv.email}</a><a href={cv.github}>github.com/meymchen</a></div><p class="resume-summary">{cv.summary}</p></header>
    {cv.sections.map(section => <section id={'id' in section ? section.id : undefined} class="resume-section"><h2>{section.title}</h2>{section.entries.map(entry => <article class="resume-entry"><div class="resume-entry-heading"><h3>{entry.title}</h3><span>{entry.meta}</span></div>{'subtitle' in entry && <p class="resume-subtitle">{entry.subtitle}</p>}<ul>{entry.bullets.map(b => <li>{b}</li>)}</ul>{'links' in entry && <div class="resume-links">{entry.links?.map(link => <a href={link.url}>{link.label} ↗</a>)}</div>}{projects.filter(project => project.record.title === entry.title).map(project => <div class="inline-links"><a href={`${home}projects/${project.slug}/`}>查看项目与相关内容 →</a></div>)}</article>)}</section>)}
    <p class="resume-note">{cv.note} <a href={`${home}sources/`}>指标与参考 ↗</a></p>
  </div>
</Layout>
<style>
  .resume-toolbar{display:flex;justify-content:space-between;align-items:center;padding-block:32px;font-size:13px;gap:20px}.resume-toolbar>div{display:flex;gap:12px}.resume-toolbar button{background:transparent;color:var(--text)}.resume-document{max-width:900px;margin:0 auto 80px;padding:55px 64px;background:#fff;border:1px solid var(--line);box-shadow:0 10px 40px #22332205}.resume-heading h1{font-size:35px;letter-spacing:0;margin:15px 0 10px}.resume-heading h1 span{font-size:20px;color:var(--muted);margin-left:15px;font-weight:400}.resume-role{font-size:15px}.resume-contact{display:flex;flex-wrap:wrap;gap:8px 22px;font-size:12px;color:var(--muted);margin-top:14px}.resume-summary{font-size:14px;margin-top:24px;line-height:1.95}.resume-section{margin-top:30px}.resume-section h2{font-size:18px;font-weight:600;letter-spacing:0;color:var(--accent);border-bottom:1px solid var(--line);padding-bottom:9px}.resume-entry{margin-top:19px}.resume-entry-heading{display:flex;align-items:baseline;justify-content:space-between;gap:18px}.resume-entry h3{font-size:15px;font-weight:600;line-height:1.8}.resume-entry-heading>span{white-space:nowrap;font-size:11px;color:var(--muted)}.resume-subtitle{font-size:12px;color:var(--muted);margin-top:2px}.resume-entry ul{padding-left:19px;margin-block:9px;font-size:13px;line-height:1.9}.resume-entry li+li{margin-top:5px}.resume-links{display:flex;flex-wrap:wrap;gap:12px;font-size:11px;color:var(--accent)}.resume-note{border-top:1px solid var(--line);padding-top:15px;margin-top:30px;font-size:10px;color:var(--muted)}
  @media(max-width:720px){.resume-toolbar{align-items:start;font-size:11px}.resume-toolbar>div{flex-wrap:wrap;justify-content:end}.resume-toolbar .button{font-size:11px;padding:10px 14px}.resume-document{margin:0 12px 40px;padding:28px 20px}.resume-heading h1{font-size:29px}.resume-heading h1 span{font-size:16px;margin-left:9px}.resume-entry-heading{display:block}.resume-entry-heading>span{display:block;margin-top:4px}.resume-summary{font-size:13px}}
  @media print{.resume-toolbar{display:none}.resume-document{max-width:none;margin:0;padding:0;border:0;box-shadow:none}.resume-entry{break-inside:avoid}.resume-section h2{break-after:avoid}.resume-heading h1{font-size:24pt}.resume-entry ul{font-size:9pt}.resume-summary{font-size:10pt}.resume-section{margin-top:15px}.resume-note{font-size:8pt}@page{size:A4;margin:15mm}}
</style>
